{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "version": 2,
  "builds": [
    {
      "src": "/src/server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/server.js"
    }
  ],
  "env": {
    "PORT": "3000"
  }
}
